{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Homelab edge route catalog",
  "type": "object",
  "required": ["schema_version", "tls", "entrypoints", "routes"],
  "properties": {
    "schema_version": {"const": 1},
    "entrypoints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "tls": {
      "type": "object",
      "required": ["cert_resolver", "wildcard_domain", "root_domain"],
      "properties": {
        "cert_resolver": {"type": "string"},
        "wildcard_domain": {"type": "string"},
        "root_domain": {"type": "string"}
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "hostnames", "exposure", "owner", "backend", "health_path", "rollback_version"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "hostnames": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "rule": {"type": "string"},
          "priority": {"type": "integer", "minimum": 1},
          "exposure": {"enum": ["public", "lan", "netbird", "internal"]},
          "owner": {"type": "string", "minLength": 1},
          "middlewares": {"type": "array", "items": {"type": "string"}},
          "backend": {
            "type": "object",
            "required": ["kind", "url"],
            "properties": {
              "kind": {"enum": ["service_dns", "tunnel", "mac_exception"]},
              "url": {"type": "string", "pattern": "^(http|h2c)://"}
            },
            "additionalProperties": false
          },
          "health_path": {"type": "string", "pattern": "^/"},
          "rollback_version": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
