[Unit]
Description=External homelab public-route heartbeat
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/lib/homelab-external-heartbeat/external-heartbeat.py
Environment=MEZON_WEBHOOK_FILE=/etc/homelab-external-heartbeat/mezon-webhook
Environment=HEARTBEAT_STATE_FILE=/var/lib/homelab-external-heartbeat/state
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/homelab-external-heartbeat
TimeoutStartSec=2min
