[Unit]
Description=Restrict RustDesk browser WebSocket listeners
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '/usr/sbin/iptables -C INPUT -p tcp -m multiport --dports 21118,21119 -j DROP 2>/dev/null || /usr/sbin/iptables -I INPUT -p tcp -m multiport --dports 21118,21119 -j DROP'
ExecStop=/bin/sh -c '/usr/sbin/iptables -D INPUT -p tcp -m multiport --dports 21118,21119 -j DROP 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
