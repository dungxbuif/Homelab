[Unit]
Description=Homelab backup health check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/apps/homelab-backup/app
EnvironmentFile=/etc/homelab-backup/runner.env
Environment="BACKUP_HEALTH_EXPECTED_CLASSES=gitlab database-instances configs"
Environment="BACKUP_HEALTH_DATABASES_MAX_AGE_SECONDS=7200"
Environment="BACKUP_HEALTH_DISK_WARN_PERCENT=85"
Environment="BACKUP_HEALTH_DISK_FAIL_PERCENT=92"
Environment="BACKUP_HEALTH_NOTIFY_SUCCESS=true"
Environment="BACKUP_HEALTH_RESTORE_DRILL_MAX_AGE_SECONDS=2678400"
Environment="BACKUP_HEALTH_REMOTE_PI=true"
SyslogIdentifier=homelab-backup-health
StandardOutput=journal
StandardError=journal
ExecStart=/opt/apps/homelab-backup/app/backup/scripts/check-backup-health.sh --notify
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/opt/apps/homelab-backup /run/lock /tmp
TimeoutStartSec=5min
