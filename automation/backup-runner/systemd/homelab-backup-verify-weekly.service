[Unit]
Description=Weekly deep Restic integrity verification
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/apps/homelab-backup/app
EnvironmentFile=/etc/homelab-backup/runner.env
Environment=RCLONE_CONFIG_WORK_ROOT=/home/ubuntu/.homelab-backup-runtime
Environment=RESTIC_READ_DATA_SUBSET=1/10
SyslogIdentifier=homelab-backup-verify-weekly
StandardOutput=journal
StandardError=journal
ExecStart=/opt/apps/homelab-backup/app/automation/backup-runner/run-vm100-scheduled.sh weekly-integrity
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ReadWritePaths=/opt/apps/homelab-backup /run/lock /tmp
TimeoutStartSec=12h
TimeoutStopSec=2min
KillMode=control-group
