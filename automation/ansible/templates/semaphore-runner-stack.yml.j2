version: '3.8'
services:
  runner:
    image: '{{ semaphore_runner_image }}'
    user: '1001:1001'
    dns:
      - 10.10.0.5
    secrets:
      - source: '{{ semaphore_runner_secret }}'
        target: semaphore_runner_config
        uid: '1001'
        gid: '1001'
        mode: 0400
    networks:
      - homelab-net
    logging:
      driver: json-file
      options:
        max-size: 10m
        max-file: '3'
    deploy:
      replicas: 1
      placement:
        constraints:
          - node.hostname == vm100-prod
      resources:
        limits:
          cpus: '1.0'
          memory: 1G
        reservations:
          cpus: '0.1'
          memory: 128M
      update_config:
        order: stop-first
        failure_action: rollback
        monitor: 30s
      restart_policy:
        condition: on-failure
        delay: 10s
secrets:
  '{{ semaphore_runner_secret }}':
    external: true
networks:
  homelab-net:
    external: true
