concurrent = 1
check_interval = 5
shutdown_timeout = 30

[[runners]]
  name = "vm100-rootless-homelab-automation"
  url = "https://gitlab.dungxbuif.com"
  id = {{ runner_credential.id }}
  token = {{ runner_credential.token | to_json }}
  executor = "docker"
  limit = 1
  request_concurrency = 1
  environment = ["FF_NETWORK_PER_BUILD=true"]
  [runners.docker]
    host = "unix:///var/run/docker.sock"
    image = "docker:27.5.1-cli"
    privileged = false
    services_privileged = true
    allowed_privileged_services = ["docker:27.5.1-dind-rootless", "docker.io/library/docker:27.5.1-dind-rootless"]
    allowed_services = ["docker:27.5.1-dind-rootless", "docker.io/library/docker:27.5.1-dind-rootless"]
    allowed_images = ["docker:27.5.1-cli", "docker.io/library/docker:27.5.1-cli", "registry-gitlab.dungxbuif.com/dungxbuif/homelab-automation/automation-ee@sha256:835cce544bde8fba8a381929d2e59dd8a95019c83c83f7ebb84e090cdd76c0a6"]
    volumes = ["/certs/client", "/cache"]
    memory = "512m"
    cpus = "1"
    service_memory = "3g"
    service_cpus = "2"
    pull_policy = "if-not-present"
    allowed_pull_policies = ["always", "if-not-present"]
    shm_size = 67108864
