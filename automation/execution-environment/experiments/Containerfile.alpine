FROM homelab-automation-ee:no-pip-20261015 AS existing
FROM python:3.13.16-alpine3.24@sha256:2d9aefe2fef018a7eb2c13064c89c71929800fd2e5dccdbf52ea5da5bb8d929a
ENV ANSIBLE_COLLECTIONS_PATH=/usr/share/ansible/collections \
    PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONDONTWRITEBYTECODE=1
RUN apk add --no-cache bash ca-certificates curl git jq openssh-client \
    ruby ruby-minitest shellcheck coreutils findutils
COPY requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir --only-binary=:all: -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt
COPY requirements.yml /tmp/requirements.yml
RUN ansible-galaxy collection install --collections-path /usr/share/ansible/collections -r /tmp/requirements.yml \
    && rm /tmp/requirements.yml \
    && python -m pip uninstall --yes pip
COPY --from=existing /usr/local/bin/docker /usr/local/bin/docker
COPY --from=existing /usr/local/bin/tofu /usr/local/bin/tofu
COPY test-toolchain.sh /usr/local/bin/test-toolchain
RUN chmod 0755 /usr/local/bin/test-toolchain
RUN apk add --no-cache flock
LABEL org.homelab.experimental="true" org.homelab.base="alpine3.24-compatibility-only"
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/test-toolchain"]
CMD ["--run"]
