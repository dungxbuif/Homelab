ARG TOFU_VERSION=1.9.0
ARG DOCKER_CLI_VERSION=27.5.1
ARG SHELLCHECK_VERSION=0.10.0

FROM alpine:3.21.3 AS tofu
ARG TOFU_VERSION
ARG TARGETARCH
RUN apk add --no-cache ca-certificates curl unzip \
    && case "${TARGETARCH}" in \
         amd64) tofu_arch='amd64' ;; \
         arm64) tofu_arch='arm64' ;; \
         *) echo "unsupported architecture: ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && tofu_zip="tofu_${TOFU_VERSION}_linux_${tofu_arch}.zip" \
    && curl --fail --silent --show-error --location \
         "https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/${tofu_zip}" \
         --output "/tmp/${tofu_zip}" \
    && curl --fail --silent --show-error --location \
         "https://github.com/opentofu/opentofu/releases/download/v${TOFU_VERSION}/tofu_${TOFU_VERSION}_SHA256SUMS" \
         --output /tmp/SHA256SUMS \
    && cd /tmp \
    && grep "${tofu_zip}" SHA256SUMS | sha256sum -c - \
    && unzip -p "/tmp/${tofu_zip}" tofu > /usr/local/bin/tofu \
    && chmod 0755 /usr/local/bin/tofu \
    && rm -rf /tmp/*
FROM docker:${DOCKER_CLI_VERSION}-cli AS docker-cli
FROM koalaman/shellcheck:v${SHELLCHECK_VERSION} AS shellcheck

FROM python:3.13.7-slim-bookworm

ARG ANSIBLE_CORE_VERSION=2.18.6
ARG ANSIBLE_LINT_VERSION=25.5.0
ARG YAMLLINT_VERSION=1.37.1

ENV ANSIBLE_COLLECTIONS_PATH=/usr/share/ansible/collections \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update \
    && apt-get install --no-install-recommends --yes \
        ca-certificates \
        curl \
        git \
        jq \
        openssh-client \
        ruby \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir \
      "ansible-core==${ANSIBLE_CORE_VERSION}" \
      "ansible-lint==${ANSIBLE_LINT_VERSION}" \
      "yamllint==${YAMLLINT_VERSION}" \
      -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY requirements.yml /tmp/requirements.yml
RUN ansible-galaxy collection install \
      --collections-path /usr/share/ansible/collections \
      -r /tmp/requirements.yml \
    && rm /tmp/requirements.yml

COPY --from=tofu /usr/local/bin/tofu /usr/local/bin/tofu
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=shellcheck /bin/shellcheck /usr/local/bin/shellcheck

COPY tests/test-toolchain.sh /usr/local/bin/test-toolchain
RUN chmod 0755 /usr/local/bin/test-toolchain

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/test-toolchain"]
