ARG TOFU_VERSION=1.13.1
ARG TOFU_COMMIT=233700b795b6d2372f1c56ed57a4abaec9d36475
ARG DOCKER_CLI_VERSION=29.9.0
ARG SHELLCHECK_VERSION=0.10.0

FROM golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61 AS tofu-build
ARG TOFU_VERSION
ARG TOFU_COMMIT
COPY experiments/opentofu-1.13.1-dependencies.patch /tmp/opentofu-dependencies.patch
RUN set -eux; \
    timeout 5m git clone --filter=blob:none --no-checkout https://github.com/opentofu/opentofu.git /src; \
    cd /src; \
    git checkout --detach "${TOFU_COMMIT}"; \
    test "$(git rev-parse HEAD)" = "${TOFU_COMMIT}"; \
    git apply --check /tmp/opentofu-dependencies.patch; \
    git apply /tmp/opentofu-dependencies.patch; \
    go mod verify; \
    timeout 15m env CGO_ENABLED=0 GOOS=linux go build -p=2 -mod=readonly -trimpath -buildvcs=true \
      -ldflags "-X github.com/opentofu/opentofu/version.dev=no -X github.com/opentofu/opentofu/version.rawVersion=${TOFU_VERSION}-homelab.1" \
      -o /usr/local/bin/tofu ./cmd/tofu; \
    chmod 0755 /usr/local/bin/tofu; \
    rm -rf /src /tmp/opentofu-dependencies.patch
FROM docker:${DOCKER_CLI_VERSION}-cli@sha256:1a4c7cb63513f349bdad01fcc6e0f3f2f67d37b9da86f14dc0d4a0942eecda00 AS docker-cli
FROM koalaman/shellcheck:v${SHELLCHECK_VERSION} AS shellcheck

FROM python:3.13.16-alpine3.24@sha256:2d9aefe2fef018a7eb2c13064c89c71929800fd2e5dccdbf52ea5da5bb8d929a

ARG ANSIBLE_CORE_VERSION=2.18.19
ARG ANSIBLE_LINT_VERSION=25.5.0
ARG YAMLLINT_VERSION=1.37.1

ENV ANSIBLE_COLLECTIONS_PATH=/usr/share/ansible/collections \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apk add --no-cache \
        bash \
        ca-certificates \
        coreutils \
        curl \
        findutils \
        flock \
        git \
        jq \
        openssh-client \
        ruby \
        ruby-minitest \
        shellcheck

COPY requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir \
      "ansible-core==${ANSIBLE_CORE_VERSION}" \
      "ansible-lint==${ANSIBLE_LINT_VERSION}" \
      "yamllint==${YAMLLINT_VERSION}" \
      -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

COPY requirements.yml /tmp/requirements.yml
RUN timeout 10m ansible-galaxy collection install \
      --collections-path /usr/share/ansible/collections \
      --timeout 60 \
      -r /tmp/requirements.yml \
    && rm /tmp/requirements.yml

RUN python -m pip uninstall --yes pip

COPY --from=tofu-build /usr/local/bin/tofu /usr/local/bin/tofu
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=shellcheck /bin/shellcheck /usr/local/bin/shellcheck

COPY tests/test-toolchain.sh /usr/local/bin/test-toolchain
RUN chmod 0755 /usr/local/bin/test-toolchain

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/test-toolchain"]
CMD ["--run"]
