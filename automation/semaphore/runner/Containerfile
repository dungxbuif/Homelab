ARG AUTOMATION_EE_IMAGE
FROM semaphoreui/semaphore@sha256:19b8769d95849418104bf51eca0dfd4559f76eab7b89030bf88c7531465b27f1 AS semaphore
FROM ${AUTOMATION_EE_IMAGE}

COPY --from=semaphore /usr/local/bin/semaphore /usr/local/bin/semaphore
RUN addgroup -S -g 1001 semaphore \
    && adduser -S -D -H -u 1001 -G semaphore semaphore \
    && mkdir -p /tmp/semaphore /opt/semaphore \
    && chown 1001:1001 /tmp/semaphore /opt/semaphore

ENV HOME=/home/semaphore
USER 1001:1001
WORKDIR /home/semaphore
ENTRYPOINT ["/usr/local/bin/semaphore"]
CMD ["runner", "start", "--config", "/run/secrets/semaphore_runner_config"]
